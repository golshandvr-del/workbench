<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/companion_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/companion_title"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/companion_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textSize="14sp" />

        <LinearLayout
            android:id="@+id/pair_section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <Button
                android:id="@+id/scan_button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/scan_button" />

            <TextView
                android:id="@+id/manual_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/manual_label"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/pair_address"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:autofillHints=""
                android:hint="@string/pair_address_hint"
                android:inputType="textUri"
                android:minHeight="48dp" />

            <EditText
                android:id="@+id/pair_code"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:autofillHints=""
                android:hint="@string/pair_code_hint"
                android:inputType="textNoSuggestions|textVisiblePassword|textCapCharacters"
                android:maxLength="19"
                android:minHeight="48dp" />

            <Button
                android:id="@+id/pair_button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/pair_button" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/paired_section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <Button
                android:id="@+id/refresh_button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/refresh_state" />

            <TextView
                android:id="@+id/state_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="#F1F3F4"
                android:fontFamily="monospace"
                android:padding="12dp"
                android:textIsSelectable="true"
                android:textSize="13sp" />

            <EditText
                android:id="@+id/task_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:autofillHints=""
                android:hint="@string/task_title_hint"
                android:inputType="text"
                android:minHeight="48dp" />

            <EditText
                android:id="@+id/task_objective"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:autofillHints=""
                android:hint="@string/task_objective_hint"
                android:inputType="textMultiLine"
                android:minHeight="48dp" />

            <Button
                android:id="@+id/create_task_button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/create_task" />

            <EditText
                android:id="@+id/answer_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:autofillHints=""
                android:gravity="top"
                android:hint="@string/answer_hint"
                android:inputType="textMultiLine"
                android:minLines="4" />

            <Button
                android:id="@+id/submit_answer_button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/submit_answer" />

            <Button
                android:id="@+id/unpair_button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/unpair" />
        </LinearLayout>

        <TextView
            android:id="@+id/companion_note"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/companion_note"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
