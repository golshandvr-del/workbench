{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/golshandvr-del/workbench/packages/contracts/release-manifest.v1",
  "title": "Release manifest v1",
  "type": "object",
  "required": ["schema_version", "app", "platform", "version", "channel", "artifacts"],
  "properties": {
    "schema_version": {"const": 1},
    "app": {"enum": ["ai-workbench-desktop", "ai-workbench-mobile"]},
    "platform": {"enum": ["windows", "android"]},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "channel": {"enum": ["stable", "beta", "dev"]},
    "installer": {"type": "string", "minLength": 1, "maxLength": 200},
    "tag": {"type": "string", "pattern": "^(desktop|mobile)-v[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "commit_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "repository": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"},
    "build_run_id": {"type": "string", "pattern": "^[0-9]+$"},
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "size", "sha256"],
        "properties": {
          "name": {"type": "string", "pattern": "^[A-Za-z0-9._ -]{1,200}$"},
          "size": {"type": "integer", "minimum": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
