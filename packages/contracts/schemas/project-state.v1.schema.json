{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/golshandvr-del/workbench/packages/contracts/schemas/project-state.v1.schema.json",
  "title": "AI Workbench V2 Project State Snapshot (.aiwb/project-state.json) and Evidence record",
  "type": "object",
  "required": [
    "content_hash",
    "project_id",
    "schema_version",
    "source",
    "state_revision",
    "summary",
    "tasks"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "state_revision": {
      "type": "integer",
      "minimum": 0
    },
    "generated_at_utc": {
      "type": "string"
    },
    "content_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "previous_snapshot_hash": {
      "type": "string",
      "pattern": "^([0-9a-f]{64})?$"
    },
    "source": {
      "type": "object",
      "required": [
        "commit_sha",
        "local_changes_pending"
      ],
      "properties": {
        "repository": {
          "type": "string"
        },
        "branch": {
          "type": "string"
        },
        "commit_sha": {
          "type": "string"
        },
        "local_changes_pending": {
          "type": "boolean"
        },
        "local_changes_count": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": true
    },
    "summary": {
      "type": "object",
      "required": [
        "total_tasks",
        "verified_complete"
      ],
      "properties": {
        "total_tasks": {
          "type": "integer",
          "minimum": 0
        },
        "active_tasks": {
          "type": "integer",
          "minimum": 0
        },
        "blocked_tasks": {
          "type": "integer",
          "minimum": 0
        },
        "needs_decision": {
          "type": "integer",
          "minimum": 0
        },
        "awaiting_review": {
          "type": "integer",
          "minimum": 0
        },
        "validation_pending": {
          "type": "integer",
          "minimum": 0
        },
        "verified_complete": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": true
    },
    "active_task_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "blocked_task_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "needs_decision_task_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "done_task_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "open_decision_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "accepted_decisions": {
      "type": "array"
    },
    "last_verified_evidence_id": {
      "type": "string"
    },
    "last_published_state_revision": {
      "type": "integer",
      "minimum": 0
    },
    "next_action": {
      "type": [
        "object",
        "null"
      ]
    },
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "status",
          "task_id",
          "task_revision"
        ],
        "properties": {
          "task_id": {
            "type": "string"
          },
          "task_revision": {
            "type": "integer",
            "minimum": 0
          },
          "title": {
            "type": "string"
          },
          "status": {
            "enum": [
              "draft",
              "proposed",
              "ready",
              "in_progress",
              "blocked",
              "needs_decision",
              "in_review",
              "validation_pending",
              "done",
              "cancelled",
              "superseded"
            ]
          },
          "owner_agent_id": {
            "type": "string"
          },
          "depends_on": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "blocked_reason": {
            "type": "string"
          },
          "verified_evidence_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true,
  "$defs": {
    "evidence": {
      "type": "object",
      "required": [
        "evidence_id",
        "result",
        "schema_version",
        "source",
        "subject_id",
        "type",
        "verified"
      ],
      "properties": {
        "schema_version": {
          "const": "1.0"
        },
        "evidence_id": {
          "type": "string",
          "pattern": "^EV-[0-9]{4,}$"
        },
        "type": {
          "enum": [
            "model_report",
            "file_change",
            "test_run",
            "build_run",
            "git_operation",
            "manual_review",
            "external_artifact"
          ]
        },
        "subject_type": {
          "type": "string"
        },
        "subject_id": {
          "type": "string"
        },
        "result": {
          "type": "string"
        },
        "verified": {
          "type": "boolean"
        },
        "source": {
          "type": "object",
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "enum": [
                "workbench_process_runner",
                "workbench_apply",
                "github_actions",
                "git",
                "user",
                "model"
              ]
            },
            "run_id": {
              "type": "string"
            },
            "commit_sha": {
              "type": "string"
            }
          },
          "additionalProperties": true
        },
        "task_revision": {
          "type": "integer",
          "minimum": 0
        },
        "observed_at_utc": {
          "type": "string"
        }
      },
      "additionalProperties": true,
      "allOf": [
        {
          "if": {
            "properties": {
              "source": {
                "properties": {
                  "kind": {
                    "const": "model"
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "verified": {
                "const": false
              }
            }
          }
        }
      ]
    }
  }
}
