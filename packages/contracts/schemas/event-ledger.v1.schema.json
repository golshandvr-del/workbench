{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/golshandvr-del/workbench/packages/contracts/schemas/event-ledger.v1.schema.json",
  "title": "AI Workbench Event Ledger record (one line of .workbench/v2/events.jsonl, ADR-008)",
  "type": "object",
  "required": ["schema", "event_id", "project_id", "state_revision", "timestamp_utc", "time_source", "event_type", "family", "source", "refs"],
  "properties": {
    "schema": {"const": "event-ledger.v1"},
    "event_id": {"type": "string", "pattern": "^LE-[0-9]{6,}-[0-9]{2,}$"},
    "project_id": {"type": "string"},
    "state_revision": {"type": "integer", "minimum": 0},
    "timestamp_utc": {"type": "string", "description": "empty when the source time is unknown (legacy)"},
    "time_source": {"enum": ["workbench_clock", "user_confirmed", "unknown"]},
    "event_type": {"type": "string", "minLength": 1, "maxLength": 60},
    "family": {"enum": ["task", "attempt", "handoff", "decision", "evidence", "team", "version", "publish", "context", "other"]},
    "source": {"enum": ["workbench", "user", "model", "github_actions"]},
    "refs": {"type": "object"},
    "before": {"type": "object"},
    "after": {"type": "object"},
    "payload": {"type": "object"},
    "reason": {"type": "string", "maxLength": 300},
    "evidence_level": {"enum": ["verified", "reported", "not_run", "failed"]},
    "legacy_import": {"type": "boolean"}
  },
  "additionalProperties": false
}
