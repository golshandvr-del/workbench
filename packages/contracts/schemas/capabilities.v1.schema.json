{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/golshandvr-del/workbench/packages/contracts/capabilities.v1",
  "title": "Capability status v1 (reporting only, never feature gating)",
  "type": "object",
  "required": ["schema_version", "capabilities"],
  "properties": {
    "schema_version": {"const": 1},
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "title", "desktop", "mobile"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]{1,60}$"},
          "title": {"type": "string", "minLength": 1, "maxLength": 120},
          "roadmap": {"type": "string", "maxLength": 40},
          "desktop": {"$ref": "#/$defs/status"},
          "mobile": {"$ref": "#/$defs/status"},
          "evidence": {"type": "string", "maxLength": 300}
        },
        "additionalProperties": false
      }
    }
  },
  "$defs": {"status": {"enum": ["planned", "in_progress", "implemented", "partial", "not_applicable", "blocked"]}},
  "additionalProperties": false
}
