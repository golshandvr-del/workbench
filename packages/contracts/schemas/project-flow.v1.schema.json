{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/golshandvr-del/workbench/packages/contracts/schemas/project-flow.v1.schema.json",
  "title": "AI Workbench project flow (owner's algorithm, roadmap 4.x)",
  "description": "Nodes and edges of the owner's flowchart. kind: app = done by the app, user = done by the user, github = GitHub integration the app prepares and the user authorises.",
  "type": "object",
  "required": ["schema_version", "flow_id", "phases", "nodes", "edges"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "flow_id": {"type": "string", "minLength": 1},
    "source": {"type": "string"},
    "kinds": {"type": "object", "additionalProperties": {"type": "string"}},
    "phases": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z_]+$"}},
    "nodes": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "required": ["id", "title", "kind", "phase"], "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "pattern": "^F[0-9]+$"},
          "title": {"type": "string", "minLength": 1},
          "kind": {"enum": ["app", "user", "github"]},
          "phase": {"type": "string", "pattern": "^[a-z_]+$"}
        }
      }
    },
    "edges": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "required": ["from", "to"], "additionalProperties": false,
        "properties": {
          "from": {"type": "string", "pattern": "^F[0-9]+$"},
          "to": {"type": "string", "pattern": "^F[0-9]+$"},
          "when": {"enum": ["yes", "no"]}
        }
      }
    },
    "limits": {"type": "object", "properties": {"troubleshoot_attempts": {"type": "integer", "minimum": 1}}}
  },
  "additionalProperties": false
}
