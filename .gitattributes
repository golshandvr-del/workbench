# Normalise text to LF in the repository and in every checkout (Linux, macOS, Windows),
# so builds are byte-reproducible regardless of core.autocrlf.
* text=auto eol=lf

# Installer payload files are shipped byte-for-byte; never let Git rewrite them.
# (tools/build_desktop_installer.py reproduces the published 1.14.4 installer exactly.)
apps/desktop/install.ps1 -text
apps/desktop/uninstall.bat -text

# Windows scripts generated by tools keep CRLF
apps/mobile/android/gradlew.bat text eol=crlf

# Binary files
*.jar binary
*.png binary
*.jpg binary
*.ico binary
*.zip binary
*.p12 binary
